FROM localhost/enterprise-python:3.9

# Identify the application image and its release version.
LABEL org.opencontainers.image.title="Enterprise Health Service"
LABEL org.opencontainers.image.version="1.0.1"
LABEL org.opencontainers.image.description="Isolated infrastructure health service"

# Establish the application working directory.
WORKDIR /app

# Include only the required application source.
COPY application/health_service.py /app/health_service.py

# Prevent bytecode generation and enable immediate logging.
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Configure the internal application listener.
ENV SERVICE_HOST=0.0.0.0
ENV SERVICE_PORT=8080

# Restrict execution to an unprivileged container identity.
USER 10001:10001

# Specify the signal used for controlled termination.
STOPSIGNAL SIGTERM

# Document the internal service port.
EXPOSE 8080

# Start the application directly as the container process.
ENTRYPOINT ["/usr/bin/python3", "/app/health_service.py"]